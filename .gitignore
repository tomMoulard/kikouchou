# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files. `*.local` above already covers .env.local, but a bare .env or a
# .env.production must never be committed — they hold the same values plus,
# eventually, SMTP and service-role credentials.
.env
.env.*
!.env.example

# Supabase CLI local state: linked project ref, generated types, temp files.
supabase/.branches
supabase/.temp

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

coverage/
playwright-report/
test-results/
public/icons/
public/favicon.ico
.opencode/node_modules
.omx/

# Local secrets. The variable names live in .env.example so a fresh clone and
# CI can see what needs setting; only the values stay out of the repo.
.env
.env.*
!.env.example

