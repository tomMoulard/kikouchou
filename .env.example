# Supabase — the publishable key is embedded in the client bundle by design.
# It is not a secret: Row-Level Security is what protects the data. Every table
# must have RLS enabled in the same migration that creates it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# PostHog browser analytics
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
