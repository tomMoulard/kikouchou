{
  "name": "kikouchou",
  "private": true,
  "version": "0.1.10",
  "versionCode": 1010,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prod": "vite --mode production",
    "validate": "bun run generate-proto && bun run test:run && bun run lint && bun run build && bun run test:e2e",
    "build": "tsc -b && VITE_APP_VERSION=${VITE_APP_VERSION:-$npm_package_version} vite build",
    "build:native": "bun run build && cap sync",
    "generate-proto": "NODE_NO_WARNINGS=1 PATH=\"$PWD/node_modules/.bin:$PATH\" buf generate && node scripts/generate-proto.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-app-icons.js && node scripts/generate-icons.js",
    "generate-app-icons": "node scripts/generate-app-icons.js",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "PW_CHANNEL=chrome playwright test",
    "test:e2e:live": "PW_LIVE=1 playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:types": "node scripts/supabase-gen-types.js",
    "db:config-push": "node scripts/supabase-config-push.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
